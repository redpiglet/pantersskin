assets/qr/

# Generated print exports, previews, ZIP packages, and build reports stay local.
# These illustration selections are build inputs, so keep them versionable.
/output/**
!/output/**/
!/output/episode-illustrations/illustration-manifest.json
!/output/episode-illustrations/manga/illustration-manifest.json
!/output/episode-illustrations/manga-color/illustration-manifest.json

