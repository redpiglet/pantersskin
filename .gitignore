# macOS metadata
.DS_Store
._*
.AppleDouble/
.LSOverride

# Local Python/JavaScript dependencies and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
/.venv/
